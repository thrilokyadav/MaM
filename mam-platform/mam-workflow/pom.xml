<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.mam.platform</groupId>
    <artifactId>mam-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>mam-workflow</artifactId>
  <packaging>jar</packaging>

  <name>MAM Platform :: Workflow</name>
  <description>
    MAM editorial approval workflow bundle. Reuses Nuxeo Document Routing:
    ships a route-model archive (imported by Nuxeo's stock
    RouteModelsZipImporter) plus a small set of automation chains that
    update `broadcast:editorialStatus` on stage transitions. Contains no
    Java code.
  </description>

  <build>
    <resources>
      <!-- Manifest + Nuxeo component contribution. Route-model source
           tree is intentionally excluded here; it is zipped by the
           antrun step below and then copied into target/classes. -->
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>route-models/mam-editorial-approval/**</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
      <!-- Zip the exploded route-model tree into a Nuxeo IO archive
           (application/zip with a `.nuxeo-archive` marker at the root)
           so that Nuxeo's RouteModelsZipImporter can import it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>zip-route-model</id>
            <phase>process-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.outputDirectory}/route-models" />
                <zip destfile="${project.build.outputDirectory}/route-models/mam-editorial-approval.zip"
                     basedir="${project.basedir}/src/main/resources/route-models/mam-editorial-approval" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
