#
# Copy this file to `.env.integration` and adjust values as needed.
# NEVER commit `.env.integration` -- it is git-ignored on purpose.
# This file must not carry real tokens, passwords, or cloud endpoints.

# --- Nuxeo base image -------------------------------------------------
NUXEO_IMAGE=nuxeo/nuxeo:2025.x

# --- Host ports ---------------------------------------------------------
# Deliberately different from compose.smoke.yaml's SMOKE_HOST_PORT
# (8080) so both stacks can run side by side if needed.
INTEGRATION_HOST_PORT=8081

# --- PostgreSQL 16 ------------------------------------------------------
# Placeholder values for a throwaway local integration stack. Change
# for anything beyond disposable local testing; never put production
# credentials in this file.
PG_DB=mam_nuxeo
PG_USER=mam_nuxeo
PG_PASSWORD=mam_nuxeo_dev_only

# --- Elasticsearch 8.x ---------------------------------------------------
ES_INDEX_NAME=mam_nuxeo
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- MinIO (S3-compatible object storage) --------------------------------
MINIO_ROOT_USER=mam_minio_admin
MINIO_ROOT_PASSWORD=mam_minio_dev_only
MAM_S3_BUCKET=mam-blobs
MAM_S3_COLD_BUCKET=mam-blobs-cold
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- JVM tuning (optional, Nuxeo container) -----------------------------
JAVA_OPTS=-Xms512m -Xmx1500m
MAM_SMOKE_JWT_SECRET=smoke-secret-for-dev-integration-testing-1234567890
