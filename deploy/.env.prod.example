# (C) Copyright 2026 MAM Platform. All rights reserved.
#
# Production environment configuration for the MAM platform deployment
# stack (docker-compose.prod.yml).
#
# Copy this file to `.env` in this same directory and fill in real
# values before running `docker compose -f docker-compose.prod.yml up -d`.
# NEVER commit the resulting `.env` file -- it will contain live
# credentials. `.gitignore` in this directory already excludes it.
#
# See README-DEPLOYMENT.md for the full walkthrough (SSL setup, first
# login, backup scheduling, troubleshooting).

# ===========================================================================
# Domain / networking
# ===========================================================================

# Public hostname this deployment is reachable on. Used only in this file's
# comments and README-DEPLOYMENT.md's certbot examples -- nginx/nginx.conf
# itself uses `server_name _;` (matches any Host header) because a plain
# bind-mounted nginx.conf cannot read .env variables directly. If you need
# strict per-domain virtual host matching, edit nginx/nginx.conf directly.
MAM_DOMAIN=mam.example.com

# Host ports nginx publishes. Change only if 80/443 are already in use on
# this host (e.g. another reverse proxy in front of this one).
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===========================================================================
# Nuxeo base image / addon version tag
# ===========================================================================

NUXEO_IMAGE=nuxeo/nuxeo:2025.x
# Tag applied to the locally built mam-platform/nuxeo-prod image. Bump this
# (e.g. to a release version) each time you deploy a new mam-package build,
# so `docker compose up -d` pulls/uses the new image instead of reusing a
# cached one with the same tag.
MAM_VERSION=1.0.0

# ===========================================================================
# PostgreSQL 16 (repository backend)
# ===========================================================================

PG_DB=mam_nuxeo
PG_USER=mam_nuxeo
# REQUIRED. Generate with: openssl rand -base64 24
PG_PASSWORD=

# ===========================================================================
# Elasticsearch 8.x (full-text + faceted search)
# ===========================================================================

ES_INDEX_NAME=mam_prod
# JVM heap for the Elasticsearch container. Per Technical Architecture
# Document 2.10.3: 2 GiB heap is the baseline for the initial production
# sizing. Never set this to more than half the container's available RAM
# (Elasticsearch reserves the other half for the OS page cache, which
# backs Lucene's own on-disk index structures).
ES_JAVA_OPTS=-Xms2g -Xmx2g
# REQUIRED. Password for Elasticsearch's built-in `elastic` superuser.
# Generate with: openssl rand -base64 24
# In a larger deployment, replace this with a scoped API key instead of
# the superuser account -- see README-DEPLOYMENT.md "Elasticsearch
# security" note.
ELASTIC_PASSWORD=

# ===========================================================================
# Redis (caching / messaging tier — Tech Arch 2.2.1)
# ===========================================================================

# REQUIRED. Generate with: openssl rand -base64 24
REDIS_PASSWORD=

# ===========================================================================
# MinIO / S3 (binary storage — Tech Arch 2.4.1)
# ===========================================================================

# REQUIRED. MinIO's own minimum password length is 8 characters; use a
# real generated secret, not this placeholder.
# Generate with: openssl rand -base64 24
MINIO_ROOT_USER=mam_minio_admin
MINIO_ROOT_PASSWORD=

# Primary ("hot") and cold-tier bucket names. Created automatically by the
# minio-init container on first `docker compose up`.
MAM_S3_BUCKET=mam-blobs
MAM_S3_COLD_BUCKET=mam-blobs-cold

# To use real AWS S3 instead of the bundled MinIO container: remove the
# minio/minio-init services from docker-compose.prod.yml, point
# nuxeo.s3storage.endpoint (deploy/nuxeo/Dockerfile.prod) at your AWS
# region's S3 endpoint (or omit it — Nuxeo defaults to AWS's own resolver),
# and set MINIO_ROOT_USER/MINIO_ROOT_PASSWORD above to a real
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY pair instead.

# ===========================================================================
# OIDC / SSO (Production Authentication — Priority 2)
# ===========================================================================
# Two consumers read these: mam-web's OIDC Relying Party config (built
# into the SPA bundle by the mam-web-build container) and mam-security's
# JwtBearerAuthenticator (RS256 signature verification against the IdP's
# JWKS endpoint). No client secret is used anywhere in this stack:
# mam-web is a public SPA client (Authorization Code + PKCE), and Nuxeo
# only verifies inbound tokens, it never requests its own.

# The IdP's OIDC issuer / authority URL, e.g.
#   https://idp.example.com/realms/mam
OIDC_ISSUER=

# The public client id registered with the IdP for the mam-web SPA. Also
# used as the expected `aud` (audience) claim Nuxeo enforces on inbound
# Bearer tokens (mam.jwt.audience) -- register the IdP client and the
# audience claim it emits consistently.
OIDC_CLIENT_ID=

# The IdP's JSON Web Key Set endpoint, used by Nuxeo to verify RS256
# token signatures. Usually
#   <OIDC_ISSUER>/.well-known/jwks.json
# or discoverable via <OIDC_ISSUER>/.well-known/openid-configuration.
OIDC_JWKS_URL=

# The claim in the ID/access token carrying group/role membership, mapped
# by mam-security onto the mam-producers/mam-editors/mam-archivists/
# mam-publishers groups (see deploy/nuxeo/Dockerfile.prod's
# mam.jwt.group.map.* properties -- edit that file directly if your IdP
# uses different group names than MAM's defaults).
OIDC_GROUPS_CLAIM=groups

# mam-web redirect URIs. Leave blank to default to
# <origin>/auth/callback, <origin>/auth/silent-renew, and <origin>
# respectively (see mam-web's .env.example) -- only override if serving
# mam-web from a non-root path.
OIDC_WEB_REDIRECT_URI=
OIDC_WEB_SILENT_REDIRECT_URI=
OIDC_WEB_POST_LOGOUT_REDIRECT_URI=
OIDC_WEB_SCOPE=openid profile email groups

# ===========================================================================
# Nuxeo JVM tuning (Tech Arch 2.10.1 / 2.5.2 hardware baseline)
# ===========================================================================
# 4 GiB min / 8 GiB max heap is the baseline for the "4 vCPU / 16 GB RAM"
# Nuxeo application-tier host sizing in Technical Architecture Document
# 2.5.2. Scale up together with the host's available RAM if you provision
# a larger instance; leave headroom for the JVM's own off-heap memory
# (thread stacks, direct buffers, metaspace) and the OS.
NUXEO_JVM_ARGS=-Xms4096m -Xmx8192m
