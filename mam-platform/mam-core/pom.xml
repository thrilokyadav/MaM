<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.mam.platform</groupId>
    <artifactId>mam-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>mam-core</artifactId>
  <packaging>jar</packaging>

  <name>MAM Platform :: Core</name>
  <description>
    MAM core OSGi bundle. Registers the `broadcast` schema, the
    BroadcastAsset/BroadcastVideo document types, and the
    MAM_BROADCAST_ASSET_SEARCH named page provider (backed by a small
    custom Java PageProvider, BroadcastAssetSearchPageProvider, so the
    free-text search box can match multiple metadata columns).
  </description>

  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.ecm.core</groupId>
      <artifactId>nuxeo-core-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.ecm.core</groupId>
      <artifactId>nuxeo-core-query</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.ecm.platform</groupId>
      <artifactId>nuxeo-platform-query-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Nuxeo automation API — provides @Operation, @Param, OperationContext, etc.
      Already on the Nuxeo server classpath; provided scope keeps the JAR out
      of the addon ZIP.
    -->
    <dependency>
      <groupId>org.nuxeo.ecm.automation</groupId>
      <artifactId>nuxeo-automation-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Nuxeo WorkManager API — AbstractWork, WorkManager service (in nuxeo-core-event).
      Shipped with the Nuxeo platform; provided scope.
    -->
    <dependency>
      <groupId>org.nuxeo.ecm.core</groupId>
      <artifactId>nuxeo-core-event</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      AWS SDK v2 S3 client — bundled inside nuxeo-amazon-s3-package at
      runtime.  Declared provided here so Maven compiles against it without
      embedding a second copy in the addon JAR.
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      AWS SDK v2 Apache HTTP client — used to configure generous socket /
      connection timeouts on the cold-storage S3 client so a large
      server-side CopyObject on MinIO is not aborted by the default 30s
      read timeout. Shipped in the Nuxeo server lib dir
      (apache-client-*.jar), so provided scope keeps it out of the addon
      JAR while still compiling against it.
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>apache-client</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestFile>src/main/resources/META-INF/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
