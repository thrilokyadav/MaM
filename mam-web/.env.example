# Copy this file to `.env.local` and adjust. `.env.local` MUST NOT be committed.
# NEVER put usernames, passwords, tokens, or CLIDs in any .env file that is
# tracked by git.

# Base URL the browser uses to reach Nuxeo. Leave as `/nuxeo` in development
# so requests are same-origin and pass through the Vite dev-server proxy
# (see vite.config.ts). In production, wire /nuxeo to your reverse proxy.
VITE_NUXEO_BASE_URL=/nuxeo

# Upstream URL the Vite DEV proxy forwards `/nuxeo/*` requests to.
# Development-only. Never used by the built bundle.
VITE_NUXEO_PROXY_TARGET=http://localhost:8080

# --- OIDC / OAuth2 (Production Authentication) -----------------------
# mam-web acts as the OIDC Relying Party (public SPA client, Authorization
# Code + PKCE — no client secret is ever used or stored here). Leave
# VITE_OIDC_ISSUER and VITE_OIDC_CLIENT_ID empty to run with no auth layer
# at all (useful for VITE_MOCK_MODE / fully offline UI work): the app then
# sends no Authorization header, exactly like before this feature existed.
#
# VITE_OIDC_ISSUER: the IdP's OIDC issuer / authority URL, e.g.
#   https://idp.example.com/realms/mam
# VITE_OIDC_CLIENT_ID: the public client id registered with the IdP for
#   this SPA. Not a secret — SPAs cannot hold a client secret.
# VITE_OIDC_REDIRECT_URI / VITE_OIDC_SILENT_REDIRECT_URI /
#   VITE_OIDC_POST_LOGOUT_REDIRECT_URI: default to
#   <origin>/auth/callback, <origin>/auth/silent-renew, and <origin>
#   respectively if left empty. Override only if the deployment serves
#   mam-web from a non-root path or a different origin than the IdP
#   redirect registration expects.
# VITE_OIDC_SCOPE: space-separated OIDC scopes to request. Must include
#   whatever scope the IdP uses to emit the groups/roles claim consumed
#   by mam-security's JwtBearerAuthenticator (mam.jwt.groups.claim).
# VITE_OIDC_PERSIST_ACROSS_TABS: "true" to persist the OIDC session in
#   localStorage (shared across tabs) instead of the default
#   sessionStorage (cleared when the tab closes).
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_SILENT_REDIRECT_URI=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=
VITE_OIDC_SCOPE=openid profile email groups
VITE_OIDC_PERSIST_ACROSS_TABS=false

# --- Dev-only Basic auth fallback (local development only) ------------
# When VITE_OIDC_ISSUER/VITE_OIDC_CLIENT_ID are empty, this app sends no
# Authorization header by default, which 401s against any Nuxeo server
# that requires auth (both compose.smoke.yaml and compose.integration.yaml
# do). Set VITE_DEV_AUTH_ENABLED=true plus VITE_DEV_AUTH_USER/PASSWORD to
# have the app attach a static `Authorization: Basic` header to every
# request itself, instead of relying on the browser's own Basic-auth
# popup. Only takes effect when OIDC is NOT configured. Never set these
# to real/production credentials — this is a local dev convenience only,
# and has no effect on the production build's behavior recommendations
# (see README's Security section).
VITE_DEV_AUTH_ENABLED=false
VITE_DEV_AUTH_USER=
VITE_DEV_AUTH_PASSWORD=

# If truthy, the app uses an in-memory mock backend instead of Nuxeo.
# Useful for offline UI work. Off by default.
VITE_MOCK_MODE=false
