VITE_NUXEO_BASE_URL=/nuxeo
# Pointed at the integration stack (compose.integration.yaml), NOT the
# smoke stack (compose.smoke.yaml, port 8080). The smoke stack runs on
# embedded H2 + local filesystem blob storage only -- it has no MinIO,
# no Elasticsearch, and the cold storage blob mover has nothing to act
# on there. The integration stack is Postgres + Elasticsearch + MinIO,
# i.e. the actual MAM storage/search/archive behavior. Bring it up with:
# Pointed at smoke stack (port 8080). If switching to integration stack, change to 8081.
VITE_NUXEO_PROXY_TARGET=http://127.0.0.1:8081
# OIDC is intentionally left unconfigured for local dev against the
# smoke stack, which has no real IdP (see mam-platform/scripts/
# smoke-test.ps1's HS256 mock-JWT flow instead). With no VITE_OIDC_ISSUER/
# VITE_OIDC_CLIENT_ID, OIDC is off and the dev-auth fallback below (if
# enabled) takes over instead.
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email groups

# --- Dev-only Basic auth fallback --------------------------------------
# Enabled so the app itself authenticates every request against the
# compose.smoke.yaml stack (Administrator/Administrator is that stack's
# seeded admin account — see mam-platform/.env.smoke.example) instead of
# relying on the browser's native Basic-auth popup. NEVER set these to
# real credentials; this file stays local/git-ignored regardless, but
# treat it the same as any other credential-bearing file.
VITE_DEV_AUTH_ENABLED=true
VITE_DEV_AUTH_USER=Administrator
VITE_DEV_AUTH_PASSWORD=Administrator

VITE_MOCK_MODE=false
VITE_MAM_INGEST_PATH=/default-domain/workspaces
