#
# Copy this file to `.env.smoke` and adjust values as needed.
# NEVER commit `.env.smoke` — it is git-ignored on purpose.
# This file must not carry real tokens, passwords, or cloud endpoints.

# --- Nuxeo base image -------------------------------------------------
# Locally built 2025 image (see D:\MaM\nuxeo docker build). This image
# must already exist in the local Docker daemon; the compose stack does
# not pull from any registry.
NUXEO_IMAGE=nuxeo/nuxeo:2025.x

# --- Host port --------------------------------------------------------
# Non-privileged, non-conflicting local port. Change if 8080 is busy.
SMOKE_HOST_PORT=8080

# --- Administrator credentials ---------------------------------------
# Placeholder values. Nuxeo's default seed admin account on a fresh
# database is `Administrator/Administrator`. Change these for anything
# beyond a throwaway local smoke test. Do NOT put production credentials
# in this file — put them in `.env.smoke` (git-ignored) instead.
SMOKE_ADMIN_USER=Administrator
SMOKE_ADMIN_PASSWORD=Administrator

# --- JVM tuning (optional) -------------------------------------------
JAVA_OPTS=-Xms512m -Xmx1500m
